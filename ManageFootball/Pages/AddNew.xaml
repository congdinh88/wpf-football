<Page x:Class="ManageFootball.Pages.AddNew"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ManageFootball.Pages"
      mc:Ignorable="d" 
      Title="AddNew">

    <Border 
        Width="1000"
        Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>
            <TabControl 
            Grid.Row="1"
            TabStripPlacement="Bottom">
                <TabItem
                    Header="Chi tiết">
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto">
                        
                        <DataGrid 
                            x:Name="dataGrid"
                            VerticalGridLinesBrush="LightGray"
                            HorizontalGridLinesBrush="LightGray"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Left"
                            AutoGenerateColumns="False"
                            LoadingRow="dataGrid_LoadingRow"
                            SelectionUnit="Cell"
                            SelectionMode="Extended">

                        <DataGrid.Resources>
                            <CollectionViewSource x:Key="Team1ListSource" Source="{Binding Team1List}" />
                                <CollectionViewSource x:Key="Team2ListSource" Source="{Binding Team2List}" />
                                <CollectionViewSource x:Key="AddListSource" Source="{Binding AddList}" />
                            </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã trận" Width="100"
                                Binding="{Binding Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridComboBoxColumn Header="Đội 1" Width="150"
                                SelectedItemBinding="{Binding Team1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                ItemsSource="{Binding Source={StaticResource Team1ListSource}}" />
                            <DataGridComboBoxColumn Header="Đội 2" Width="150"
                                SelectedItemBinding="{Binding Team2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                ItemsSource="{Binding Source={StaticResource Team2ListSource}}" />
                                <DataGridComboBoxColumn Header="Địa điểm" Width="150"
                                    SelectedItemBinding="{Binding Add, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    ItemsSource="{Binding Source={StaticResource AddListSource}}" />
                                <DataGridTemplateColumn Width="100" Header="Ngày">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <DatePicker 
                                            BorderThickness="0" 
                                            SelectedDateFormat="Short">
                                            <DatePicker.Resources>
                                                <Style TargetType="{x:Type DatePickerTextBox}">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="{x:Type DatePickerTextBox}">
                                                                <TextBox x:Name="PART_TextBox"
                                                                     Text="{Binding Path=Text, RelativeSource={RelativeSource TemplatedParent}}"
                                                                     BorderThickness="0"
                                                                     Background="{TemplateBinding Background}" />
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </DatePicker.Resources>
                                        </DatePicker>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
            <StackPanel 
            Grid.Row="2"
            Orientation="Horizontal">
                <Button Margin="10" Width="100" Height="30" Content="Cập nhập"/>
                <Button Margin="10" Width="100" Height="30" Content="Hủy"/>
            </StackPanel>
        </Grid>
    </Border>
</Page>
