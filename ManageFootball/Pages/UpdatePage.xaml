<Page x:Class="ManageFootball.Pages.UpdatePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:uc="clr-namespace:ManageFootball.ControlApp"
      xmlns:local="clr-namespace:ManageFootball.Pages"
      mc:Ignorable="d" 
      xmlns:vm="clr-namespace:ManageFootball.ViewModels"
      Title="UpdatePage">
    <Page.DataContext>
        <vm:AutoCompleteVM/>
    </Page.DataContext>
    <Border 
        Width="1000"
        Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>
            <TabControl 
                Grid.Row="1"
                TabStripPlacement="Bottom">
                <TabItem
                    Header="Chi tiết">
                    <uc:AutoComplete
                        Height="40"
                        HorizontalAlignment="Left"
                        ItemsSource="{Binding AutoCompleteSuggest, Mode=TwoWay}"
                        SelectedItem="{Binding SelectedItem}"
                        SearchText="{Binding SearchText, Mode=TwoWay}"
                        SelectedValuePath="Col2"
                        Width="300"
                        Margin="10"/>
                </TabItem>
            </TabControl>
            <StackPanel 
                Grid.Row="2"
                Orientation="Horizontal">
                <Button Margin="10" Width="100" Height="30" Content="Cập nhập"/>
                <Button Margin="10" Width="100" Height="30" Content="Hủy"/>
            </StackPanel>
        </Grid>
    </Border>
</Page>
