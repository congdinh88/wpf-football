<Page x:Class="ManageFootball.Pages.UpdatePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:uc="clr-namespace:ManageFootball.ControlApp"
      xmlns:vm="clr-namespace:ManageFootball.Templetes"
      xmlns:local="clr-namespace:ManageFootball.Pages"
      mc:Ignorable="d" 
      Title="UpdatePage">
    <Border 
        Width="1000"
        Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>
            <TabControl 
                Grid.Row="1"
                TabStripPlacement="Bottom">
                <TabItem
                    Header="Chi tiết">
                    <DataGrid x:Name="MainDataGrid" 
                             SelectionUnit="Cell"
                              ItemsSource="{Binding Items}" 
                              HorizontalAlignment="Left"
                              AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Column 1">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Column1}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <uc:AutoComplete
                                            Text="{Binding Column1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Suggestions="{Binding DataContext.Suggestions, RelativeSource={RelativeSource AncestorType=Page}}"
                                            DisplayMemberPath="Col1"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Column 2">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Column2}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>

                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <uc:AutoComplete
                                            Text="{Binding Column2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Suggestions="{Binding DataContext.Suggestions, RelativeSource={RelativeSource AncestorType=Page}}"
                                            DisplayMemberPath="Col2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Column 3">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Column3}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>

                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <uc:AutoComplete
                                            Text="{Binding Column3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Suggestions="{Binding DataContext.Suggestions, RelativeSource={RelativeSource AncestorType=Page}}"
                                            DisplayMemberPath="Col3"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                </TabItem>
            </TabControl>
            <StackPanel 
                Grid.Row="2"
                Orientation="Horizontal">
                <Button Margin="10" Width="100" Height="30" Content="Cập nhập"/>
                <Button Margin="10" Width="100" Height="30" Content="Hủy"/>
                <uc:AutoComplete Width="200"
    Text="{Binding Column3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
    Suggestions="{Binding DataContext.Suggestions, RelativeSource={RelativeSource AncestorType=Page}}"
    DisplayMemberPath="Col3"/>
            </StackPanel>
        </Grid>
    </Border>
</Page>
