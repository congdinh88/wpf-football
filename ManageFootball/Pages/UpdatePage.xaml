<Page x:Class="ManageFootball.Pages.UpdatePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:uc="clr-namespace:ManageFootball.ControlApp"
      xmlns:vm="clr-namespace:ManageFootball.Templetes"
      xmlns:local="clr-namespace:ManageFootball.Pages"
      mc:Ignorable="d" 
      Title="UpdatePage">
    <Border 
        Width="1000"
        Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>
            <TabControl 
                Grid.Row="1"
                TabStripPlacement="Bottom">
                <TabItem
                    Header="Chi tiết">
                    <DataGrid 
                        x:Name="dataGrid"
                        RowHeight="30"
                        VerticalGridLinesBrush="LightGray"
                        HorizontalGridLinesBrush="LightGray"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Left"
                        AutoGenerateColumns="False"
                        LoadingRow="dataGrid_LoadingRow"
                        SelectionUnit="Cell"
                        SelectionMode="Extended">

                        <DataGrid.Resources>
                            <CollectionViewSource x:Key="CodeListSource" Source="{Binding CodeList}" />
                            <CollectionViewSource x:Key="TeamListSource" Source="{Binding TeamList}" />
                            <CollectionViewSource x:Key="NumberListSource" Source="{Binding NumberList}" />
                            <CollectionViewSource x:Key="ChoiceListSource" Source="{Binding ChoiceList}" />
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <DataGridComboBoxColumn Header="Mã trận" Width="50"
                                SelectedItemBinding="{Binding Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                ItemsSource="{Binding Source={StaticResource CodeListSource}}" />

                            <DataGridComboBoxColumn Header="Đội bóng" Width="100"
                                SelectedItemBinding="{Binding Team, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                ItemsSource="{Binding Source={StaticResource TeamListSource}}" />

                           
                            <DataGridTemplateColumn Header="Số áo" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Number}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ContentControl ContentTemplate="{DynamicResource FilteredComboBoxTemplate}" />
                                        
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Bàn thắng/thẻ" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Choice}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox 
                                            ItemsSource="{Binding Source={StaticResource ChoiceListSource}}" 
                                            SelectedValue="{Binding Choice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            IsEditable="True"
                                            StaysOpenOnEdit="True"
                                            SelectedValuePath="Key"
                                            DisplayMemberPath="FormattedValue"
                                            PreviewKeyUp="ComboBox_PreviewKeyUp"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Phút" Width="50"
                                Binding="{Binding Time, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <DataGridTemplateColumn  
                                Width="100"
                                Header="test">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Test}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate >
                                    <DataTemplate >
                                        <uc:AutoComplete 
                                            SearchText="{Binding Test, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedColumn="Col2" 
                                            DataSuggesList="{Binding DataContext.MainDataList, RelativeSource={RelativeSource AncestorType=Page}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    
                </TabItem>
            </TabControl>
            <StackPanel 
                Grid.Row="2"
                Orientation="Horizontal">
                <Button Margin="10" Width="100" Height="30" Content="Cập nhập"/>
                <Button Margin="10" Width="100" Height="30" Content="Hủy"/>
            </StackPanel>
        </Grid>
    </Border>
</Page>
