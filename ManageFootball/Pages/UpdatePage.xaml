<Page x:Class="ManageFootball.Pages.UpdatePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:uc="clr-namespace:ManageFootball.ControlApp"
      xmlns:local="clr-namespace:ManageFootball.Pages"
      xmlns:cv="clr-namespace:ManageFootball.Converters"
      mc:Ignorable="d" 
      xmlns:vm="clr-namespace:ManageFootball.ViewModels"
      Title="UpdatePage">
    <Page.DataContext>
        <vm:UpdatePageVM/>
    </Page.DataContext>
    <Border 
        Width="1000"
        Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>
            <TabControl 
                Grid.Row="1"
                TabStripPlacement="Bottom">
                <TabItem
                    Header="Chi tiết">
                    <DataGrid 
                        x:Name="dataGrid" 
                        HorizontalAlignment="Left"
                        ItemsSource="{Binding TestDatagrids}"
                        EnableRowVirtualization="True"
                        LoadingRow="dataGrid_LoadingRow"
                        AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Id" Binding="{Binding Id}"/>
                            <DataGridTemplateColumn Header="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SelectItemSuggest.Col2}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <uc:AutoSuggestTextBox
                                            ItemsSource="{Binding DataContext.AutoCompleteModels,
                     RelativeSource={RelativeSource AncestorType=Page}}"
                                            FilterMemberPath="Col2"
                                            SearchText="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedItem="{Binding SelectItemSuggest, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                </TabItem>
            </TabControl>
            <StackPanel 
                Grid.Row="2"
                Orientation="Horizontal">
                <Button Margin="10" Width="100" Height="30" Content="Cập nhập"/>
                <Button Margin="10" Width="100" Height="30" Content="Hủy"/>
                
            </StackPanel>
        </Grid>
    </Border>
</Page>
