<UserControl x:Class="ManageFootball.ControlApp.AutoSuggestTextBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ManageFootball.ControlApp"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <!-- TextBox + ToggleButton -->
        <Border Height="30" BorderBrush="Gray" BorderThickness="1" CornerRadius="2">
            <Grid>
                <TextBox 
                    x:Name="PART_TextBox"
                    Padding="4"
                    Text="{Binding SearchText, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <ToggleButton 
                    x:Name="PART_Toggle"
                    Width="20" Height="20"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,0,4,0"
                    IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}">
                    <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="Black"/>
                </ToggleButton>
            </Grid>
        </Border>

        <!-- Popup chứa DataGrid gợi ý -->
        <Popup 
            x:Name="PART_Popup"
            PlacementTarget="{Binding ElementName=PART_TextBox}"
            StaysOpen="False"
            AllowsTransparency="True"
            IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource AncestorType=UserControl}}"
            PopupAnimation="Slide">
            <Border 
                Background="White" 
                BorderBrush="Gray" 
                BorderThickness="1" 
                CornerRadius="2" >
                <DataGrid 
                    x:Name="PART_DataGrid"
                    IsReadOnly="True"
                    AutoGenerateColumns="False"
                    HeadersVisibility="Column"
                    ItemsSource="{Binding FilteredView, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Height="200" 
                    Width="{Binding ActualWidth, ElementName=PART_TextBox}">
                    <DataGrid.Columns>
                        <DataGridTextColumn 
                            Header="Cột 1" 
                            Binding="{Binding Col1}" 
                            Width="*" />
                        <DataGridTextColumn 
                            Header="Cột 2" 
                            Binding="{Binding Col2}" 
                            Width="*" />
                        <DataGridTextColumn 
                            Header="Cột 3" 
                            Binding="{Binding Col3}" 
                            Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
