<UserControl x:Class="ManageFootball.ControlApp.AutoComplete"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ManageFootball.ControlApp"
             mc:Ignorable="d" >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <TextBox 
            x:Name="textBox"
            Grid.Row="0"
            BorderThickness="0"
            Text="{Binding SearchText, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
            TextChanged="TextBox_TextChanged"
            >
            <TextBox.Resources>
                <Style TargetType="TextBox">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TextBox">
                                <Grid>
                                    <Border Background="White" BorderBrush="LightGray" BorderThickness="1"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                        </Grid.ColumnDefinitions>
                                        <ScrollViewer 
                                            x:Name="PART_ContentHost"
                                            Grid.Column="0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            />
                                        <Button 
                                            Grid.Column="1"
                                            x:Name="BtnPopup"
                                            FontFamily="Segoe MDL2 Assets"
                                            Width="24"
                                            BorderThickness="0"
                                            Background="Transparent"
                                            VerticalAlignment="Stretch"
                                            HorizontalAlignment="Right"
                                            Content="&#xE70D;"
                                            Click="BtnPopup_Click"/>
                                    </Grid>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TextBox.Resources>
        </TextBox>
        <Popup 
            x:Name="popup"
            Grid.Row="1"
            AllowsTransparency="True"
            PlacementTarget="{Binding ElementName=textBox}"
            StaysOpen="False">
            <Border BorderBrush="Black" BorderThickness="1">
                <DataGrid x:Name="dataGrid"
                          HeadersVisibility="None"
                          AutoGenerateColumns="False"
                          HorizontalGridLinesBrush="LightGray"
                          VerticalGridLinesBrush="LightGray"
                          SelectionChanged="DataGrid_SelectionChanged"
                          ItemsSource="{Binding FilteredData, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                          >
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Col1}"/>
                        <DataGridTextColumn Binding="{Binding Col2}"/>
                        <DataGridTextColumn Binding="{Binding Col3}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
