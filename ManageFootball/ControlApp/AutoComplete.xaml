<UserControl x:Class="ManageFootball.ControlApp.AutoComplete"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ManageFootball.ControlApp"
             mc:Ignorable="d" >
    <Grid>
        <TextBox 
            x:Name="textBox" 
            Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}, 
            UpdateSourceTrigger=PropertyChanged}"
            LostFocus="TextBox_LostFocus"/>
        <Button x:Name="button" Content="▼" Width="20" HorizontalAlignment="Right" Click="Button_Click"/>
        <Popup x:Name="popup" 
               PlacementTarget="{Binding ElementName=textBox}" 
               Placement="Bottom"
               AllowsTransparency="True"
                PopupAnimation="Slide"
               Panel.ZIndex="1000"
               StaysOpen="False">
            <Border Background="White" BorderBrush="Gray" BorderThickness="1">
                <DataGrid x:Name="suggestionDataGrid" 
                        ItemsSource="{Binding Suggestions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        AutoGenerateColumns="False"
                        SelectionChanged="SuggestionDataGrid_SelectionChanged"
                        PreviewKeyDown="SuggestionDataGrid_PreviewKeyDown"
                        MaxHeight="200">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Col1" Binding="{Binding Col1}"/>
                        <DataGridTextColumn Header="Col2" Binding="{Binding Col2}"/>
                        <DataGridTextColumn Header="Col3" Binding="{Binding Col3}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
