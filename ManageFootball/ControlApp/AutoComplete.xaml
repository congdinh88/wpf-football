<UserControl x:Class="ManageFootball.ControlApp.AutoComplete"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ManageFootball.ControlApp"
             mc:Ignorable="d" >
    <StackPanel>
        <TextBox x:Name="textBox"
                 BorderThickness="0"
                 Height="30"
                 Text="{Binding SearchText, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                 TextChanged="TextBox_TextChanged"/>

        <Popup x:Name="popup"
               AllowsTransparency="True"
               PlacementTarget="{Binding ElementName=textBox}"
               StaysOpen="False">
            <Border BorderBrush="Black" BorderThickness="1">
                <DataGrid x:Name="dataGrid"
                          HeadersVisibility="None"
                          AutoGenerateColumns="False"
                          HorizontalGridLinesBrush="Transparent"
                          VerticalGridLinesBrush="Transparent"
                          SelectionChanged="DataGrid_SelectionChanged"
                          ItemsSource="{Binding FilteredData, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                          >
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Col1}"/>
                        <DataGridTextColumn Binding="{Binding Col2}"/>
                        <DataGridTextColumn Binding="{Binding Col3}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Popup>
    </StackPanel>
</UserControl>
